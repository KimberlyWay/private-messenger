{
    auto_https off
    admin off
}
:8080 {
    map {http.request.header.X-Real-IP} {forwarded_client} {
        "" {remote_host}
        default {http.request.header.X-Real-IP}
    }
    handle /api/* {
        request_body { max_size 16KB }
        reverse_proxy gateway:8000 {
            header_up X-Real-IP {forwarded_client}
        }
    }
    handle /healthz {
        reverse_proxy gateway:8000
    }
    handle /.well-known/matrix/client {
        header Content-Type application/json
        respond `{"m.homeserver":{"base_url":"{$PUBLIC_BASE_URL}"}}`
    }
    @matrix path /_matrix/client/* /_matrix/media/*
    handle @matrix {
        request_body { max_size 70MB }
        reverse_proxy synapse:8008 {
            header_up X-Forwarded-For {forwarded_client}
        }
    }
    # Administration and federation endpoints are not exposed.
    handle { respond 404 }
}
